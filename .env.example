# Kredensial CARTO Basemaps (5.000.000 requests/bulan gratis)
NEXT_PUBLIC_CARTO_API_KEY=
# Optional tile URL for custom map providers, including pmtiles_r2.
NEXT_PUBLIC_MAP_TILE_URL=

# Kredensial Supabase (Isi setelah membuat project di https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional for older Supabase projects that still use legacy anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by server APIs. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Backward-compatible alternative for older Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=
